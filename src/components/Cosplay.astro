---
import Preferences from "../components/Preferences.astro";
import Doodles from "../components/Doodles.astro";
import "@fontsource-variable/manrope";
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/noto-sans-thai";
import "../styles/cosplay.css";
import Icon from "./Icon.astro";
import { base, origin, home, t, type Lang } from "../data/site";
import {
  photos,
  clips,
  characters,
  cosplayHome,
  characterPath,
  photoURL,
  clipURL,
  clipPoster,
  instagram,
  tiktok,
  type Character,
} from "../data/cosplay";
interface Props {
  lang: Lang;
  character?: Character;
}
const { lang, character } = Astro.props;
const tx = (en: string, th: string) => t(lang, en, th);
const path = (l: Lang) =>
  character ? characterPath(l, character.id) : cosplayHome(l);
const canonical = origin + path(lang);
const tikTokCount = clips.filter((c) => c.platform === "TikTok").length;
const title = character
  ? `${character.name} Cosplay — Kayyalis | Dada`
  : tx(
      "Kayyalis — Dada’s Cosplay Universe | Kunwadee",
      "Kayyalis — โลกคอสเพลย์ของ Dada | Kunwadee",
    );
const description = character
  ? tx(
      `Explore Dada’s ${character.name} cosplay from ${character.series}: ${character.photos.length} images and ${character.clips.length} cosplay videos.`,
      `ชมคอสเพลย์ ${character.name} จาก ${character.series} โดย Dada พร้อมภาพ ${character.photos.length} ภาพและวิดีโอ`,
    )
  : tx(
      `Kayyalis — Dada’s independent cosplay portfolio. Explore ${characters.length} characters, ${photos.length} gallery images and ${tikTokCount} TikTok cosplay videos, plus Instagram reels.`,
      "เข้าสู่โลกคอสเพลย์ของ Kayyalis หรือ Dada พบกับ 11 ตัวละคร ภาพในแกลเลอรี 68 ภาพ และวิดีโอ 26 คลิป จากเกมและอนิเมะที่ชื่นชอบ",
    );
const mixedPhotos = Array.from(
  { length: Math.max(...characters.map((c) => c.photos.length)) },
  (_, i) => characters.flatMap((c) => (c.photos[i] ? [c.photos[i]] : [])),
).flat();
const shownPhotos = character?.photos || mixedPhotos;
const shownClips = character?.clips || [
  ...clips.filter((c) => c.platform === "TikTok"),
  ...clips.filter((c) => c.platform === "Instagram"),
];
const hero = character?.cover || characters[0].cover;
const og = `${origin}${base}/social/cosplay-${character?.id || "kayyalis"}.jpg`;
const videoSchema = shownClips
  .filter((v) => /^\d{8}$/.test(v.date))
  .map((v) => {
    const c = characters.find((c) => c.id === v.character)!;
    return {
      "@type": "VideoObject",
      name: `${c.name} cosplay by Kayyalis`,
      description: `Dada’s ${c.name} cosplay from ${c.series}. ${v.platform} video.`,
      thumbnailUrl: origin + clipPoster(v.id),
      contentUrl: origin + clipURL(v.id),
      uploadDate: `${v.date.slice(0, 4)}-${v.date.slice(4, 6)}-${v.date.slice(6, 8)}T00:00:00+07:00`,
      duration: `PT${v.duration}S`,
      isBasedOn: v.source,
    };
  });
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": origin + cosplayHome("en") + "#kayyalis",
      name: "Kunwadee Phanompotivong",
      alternateName: ["Dada", "Kayyalis", "ダダー"],
      url: origin + cosplayHome("en"),
      image: origin + photoURL(hero.id),
      sameAs: [instagram, tiktok],
      knowsLanguage: ["Thai", "English"],
    },
    {
      "@type": character ? "CollectionPage" : "ProfilePage",
      "@id": canonical,
      url: canonical,
      name: title,
      description,
      inLanguage: lang,
      mainEntity: { "@id": origin + cosplayHome("en") + "#kayyalis" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Kayyalis",
          item: origin + cosplayHome(lang),
        },
        ...(character
          ? [
              {
                "@type": "ListItem",
                position: 2,
                name: character.name,
                item: canonical,
              },
            ]
          : []),
      ],
    },
    ...videoSchema,
    ...shownPhotos.map((p) => ({
      "@type": "ImageObject",
      contentUrl: origin + photoURL(p.id),
      name: p.alt,
      ...(p.credit ? { creator: { "@type": "Person", name: p.credit } } : {}),
      creditText: p.credit || "Kayyalis · original Instagram post",
      isBasedOn: p.source,
    })),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <Preferences />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f0ff" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={origin + path("en")} />
    <link rel="alternate" hreflang="th" href={origin + path("th")} />
    <link rel="alternate" hreflang="x-default" href={origin + path("en")} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}/cosplay/favicon.svg`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:site_name"
      content="Kayyalis — Dada’s cosplay universe"
    />
    <meta property="og:locale" content={lang === "th" ? "th_TH" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "th" ? "en_US" : "th_TH"}
    />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={title} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body class:list={["cosplay", { "character-page": character }]}>
    <a class="skip-link" href="#main">
      {tx("Skip to content", "ข้ามไปยังเนื้อหา")}
    </a>
    <div class="welcome-charm" aria-hidden="true">
      <span>✿</span>
      <small>
        kay<span>y</span>alis
      </small>
    </div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <header class="cos-header">
      <a class="cos-brand" href={cosplayHome(lang)} aria-label="Kayyalis home">
        kay<span>y</span>alis<span class="brand-flower">✿</span>
        <small>cosplay diary · ダダー</small>
      </a>
      <nav class="desktop-nav" aria-label={tx("Main navigation", "เมนูหลัก")}>
        <a href={`${cosplayHome(lang)}#characters`}>
          {tx("The wardrobe", "ตัวละคร")}
        </a>
        <a href={`${cosplayHome(lang)}#gallery`}>
          {tx("Photo diary", "ภาพถ่าย")}
        </a>
        <a href={`${cosplayHome(lang)}#motion`}>{tx("In motion", "วิดีโอ")}</a>
      </nav>
      <div class="cos-controls">
        <div class="cos-language" aria-label="Language">
          <a
            href={path("en")}
            hreflang="en"
            lang="en"
            aria-current={lang === "en" ? "page" : undefined}
          >
            EN
          </a>
          <a
            href={path("th")}
            hreflang="th"
            lang="th"
            aria-current={lang === "th" ? "page" : undefined}
          >
            ไทย
          </a>
        </div>
        <button
          class="cos-theme-toggle"
          data-theme-toggle
          aria-pressed="false"
          aria-label={tx("Dark mode", "โหมดมืด")}
        >
          <span class="light-glyph" aria-hidden="true">
            ☀
          </span>
          <span class="dark-glyph" aria-hidden="true">
            ☾
          </span>
        </button>
        <button
          class="menu-trigger"
          aria-label={tx("Open menu", "เปิดเมนู")}
          aria-controls="cos-menu"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>
    <nav
      class="chapter-dock"
      aria-label={tx("Jump to a chapter", "เลือกส่วนที่อยากชม")}
    >
      <a href="#main" data-chapter="main">
        ✿<span>{tx("Hello", "สวัสดี")}</span>
      </a>
      <a
        href={character ? "#gallery" : "#characters"}
        data-chapter={character ? "gallery" : "characters"}
      >
        ✧<span>{tx("Looks", "ตัวละคร")}</span>
      </a>
      {shownClips.length > 0 && (
        <a href="#motion" data-chapter="motion">
          ▷<span>{tx("Cinema", "วิดีโอ")}</span>
        </a>
      )}
      <a href="#contact" data-chapter="contact">
        ♡<span>{tx("Connect", "ทักทาย")}</span>
      </a>
    </nav>
    <main id="main">
      <section class="cos-hero section-pad" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <Doodles class="doodle-corner" kind="star" />
          <p class="eyebrow">
            <span class="status-dot"></span>
            {character
              ? character.series
              : tx(
                  "Dada · Thai / English · Cosplayer",
                  "Dada · ไทย / English · คอสเพลเยอร์",
                )}
          </p>
          {character ? (
            <>
              <a class="back-link" href={`${cosplayHome(lang)}#characters`}>
                ← {tx("Back to the wardrobe", "กลับไปดูตัวละคร")}
              </a>
              <h1 id="hero-heading">
                {character.name}
                <span class="serif">{tx("in character.", "ในแบบของด้า")}</span>
              </h1>
              <p class="hero-description">
                {tx(character.note.en, character.note.th)}
              </p>
            </>
          ) : (
            <>
              <h1 id="hero-heading">
                {tx("A different world.", "อีกโลกหนึ่ง")}
                <span class="serif">
                  {tx("Still a little me.", "ที่ยังเป็นด้า")}
                </span>
                <span class="handwritten">just for the love of it ♡</span>
              </h1>
              <p class="hero-description">
                {tx(
                  "I’m Dada, or Kayyalis. A little makeup, a favourite character, and the joy of becoming someone new.",
                  "ด้า หรือ Kayyalis เองค่ะ แต่งหน้าอีกนิด เลือกตัวละครที่รัก แล้วสนุกกับการเป็นใครอีกคน",
                )}
              </p>
            </>
          )}
          <div class="hero-buttons">
            <a
              class="pill primary"
              href={character ? "#gallery" : "#characters"}
            >
              {tx("Come explore", "เข้ามาดูกัน")}
              <span>↘</span>
            </a>
            {shownClips.length > 0 ? (
              <a class="text-link" href="#motion">
                <span class="play-dot">▶</span>
                {tx("Watch the transformations", "ชมการแปลงโฉม")}
              </a>
            ) : (
              <a class="text-link" href="#contact">
                {tx("Say a little hello", "ทักทายกัน")} ↗
              </a>
            )}
          </div>
          {character && (
            <div
              class="look-tags"
              style={`--look-color:${character.note.color}`}
            >
              {(lang === "th"
                ? character.note.thTags
                : character.note.tags
              ).map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          )}
          <div class="hero-note">
            <span aria-hidden="true">✧</span>
            {character
              ? `${character.photos.length} ${tx("images", "ภาพ")} · ${character.clips.length} ${tx("clips", "คลิป")}`
              : tx(
                  "A cosplay diary, made of little obsessions.",
                  "บันทึกคอสเพลย์จากสิ่งเล็ก ๆ ที่หลงรัก",
                )}
          </div>
        </div>
        <div class="hero-collage">
          <div class="orbit orbit-one" aria-hidden="true"></div>
          <div class="orbit orbit-two" aria-hidden="true"></div>
          <span class="hero-sparkle" aria-hidden="true">
            ✳
          </span>
          <button
            class="hero-photo photo-open"
            data-photo={hero.id}
            aria-label={tx(`View ${hero.name} photos`, `ชมภาพ ${hero.name}`)}
          >
            <img
              src={photoURL(hero.id)}
              srcset={`${photoURL(hero.id, true)} 640w, ${photoURL(hero.id)} 1600w`}
              sizes="(max-width: 700px) 85vw, 40vw"
              width={hero.width}
              height={hero.height}
              alt={`Dada as ${hero.name} from ${hero.series}`}
              fetchpriority="high"
            />
            <span class="photo-label">
              <small>{tx("CURRENT CHARACTER", "ตัวละคร")}</small>
              {hero.name}
              <span>↗</span>
            </span>
          </button>
          {!character && (
            <>
              <button
                class="mini-polaroid photo-open"
                data-photo={characters.find((c) => c.id === "robin")!.cover.id}
                aria-label="View Robin photo"
              >
                <img
                  src={photoURL(
                    characters.find((c) => c.id === "robin")!.cover.id,
                    true,
                  )}
                  width="200"
                  height="250"
                  alt="Dada as Robin"
                />
                <span>another little universe ♡</span>
              </button>
              <span class="sticker berry" aria-hidden="true">
                🍓
                <small>
                  made of
                  <br />
                  little dreams
                </small>
              </span>
            </>
          )}
          <span class="collage-note">
            {tx("tap for a closer look", "แตะเพื่อดูใกล้ ๆ")} ⤴
          </span>
        </div>
      </section>
      {!character && (
        <div class="collection-pass">
          <span>
            ✿ {tx("KAYYALIS / THE COSPLAY DIARY", "KAYYALIS / บันทึกคอสเพลย์")}
          </span>
          <span>
            <b>{characters.length}</b> {tx("characters", "ตัวละคร")}
          </span>
          <span>
            <b>{tikTokCount}</b> TikTok {tx("films", "วิดีโอ")}
          </span>
          <span>
            TH / ENG <i>♡</i>
          </span>
        </div>
      )}
      <div class="ribbon" aria-hidden="true">
        <span>cosplay</span>✧<span>characters</span>✿
        <span>little transformations</span>✧<span>kayyalis.cos</span>✿
        <span>just for fun</span>✧<span>cosplay</span>
      </div>
      {!character && (
        <section id="characters" class="wardrobe section-pad">
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">
                01 / {tx("PICK A UNIVERSE", "เลือกจักรวาล")}
              </p>
              <h2>
                {tx("The character", "ตู้เสื้อผ้า")}
                <em>{tx("wardrobe.", "ของตัวละคร")}</em>
              </h2>
            </div>
            <p>
              {tx(
                "A different world with every look. Pick a character and step inside.",
                "ทุกลุคคืออีกโลกหนึ่ง เลือกตัวละครแล้วเข้ามาสำรวจกัน",
              )}
            </p>
          </div>
          <div class="character-grid">
            {characters.map((c, i) => (
              <a
                class="character-card reveal"
                href={characterPath(lang, c.id)}
                style={`--card-turn:${i % 2 ? 1 : -1}deg;--look-color:${c.note.color}`}
              >
                <div class="character-visual">
                  <img
                    src={photoURL(c.cover.id, true)}
                    width={c.cover.width}
                    height={c.cover.height}
                    alt={`Dada’s ${c.name} cosplay`}
                    loading="lazy"
                  />
                  <span class="character-number">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="card-arrow" aria-hidden="true">
                    ↗
                  </span>
                </div>
                <div class="character-caption">
                  <h3>{c.name}</h3>
                  <p>{c.series}</p>
                  <p class="character-whisper">{c.note[lang]}</p>
                  <small>
                    {c.photos.length}{" "}
                    {tx(c.photos.length === 1 ? "image" : "images", "ภาพ")}{" "}
                    {c.clips.length
                      ? `· ${c.clips.length} ${tx(c.clips.length === 1 ? "clip" : "clips", "คลิป")}`
                      : ""}
                  </small>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
      <section
        id="gallery"
        class="photo-diary section-pad"
        style="position:relative"
      >
        <Doodles class="doodle-corner" kind="orbit" />
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">
              {character ? "01" : "02"} /{" "}
              {tx("THE PHOTO DIARY", "บันทึกภาพถ่าย")}
            </p>
            <h2>
              {tx("Little details.", "รายละเอียดเล็ก ๆ")}
              <em>{tx("Whole new worlds.", "ที่สร้างอีกโลก")}</em>
            </h2>
          </div>
          <p>
            {tx(
              "Portraits, favourite details and a little behind-the-scenes energy. Tap a photograph to stay a while.",
              "ภาพพอร์ตเทรต รายละเอียดที่ชอบ และช่วงเวลาเบื้องหลัง แตะภาพเพื่อดูใกล้ ๆ",
            )}
          </p>
        </div>
        <div class="gallery-toolbar">
          <div
            class="filter-pills"
            role="group"
            aria-label={tx("Filter images", "กรองภาพถ่าย")}
          >
            <button data-filter="all" aria-pressed="true">
              {tx("Everything", "ทั้งหมด")} <small>{shownPhotos.length}</small>
            </button>
            {!character && (
              <>
                <button data-filter="game" aria-pressed="false">
                  {tx("Game worlds", "เกม")}
                </button>
                <button data-filter="anime" aria-pressed="false">
                  {tx("Anime stories", "อนิเมะ")}
                </button>
              </>
            )}
          </div>
          {!character && (
            <label class="character-select">
              <span>{tx("Character", "ตัวละคร")}</span>
              <select id="character-filter">
                <option value="all">
                  {tx("All characters", "ทุกตัวละคร")}
                </option>
                {characters.map((c) => (
                  <option value={c.id}>{c.name}</option>
                ))}
              </select>
            </label>
          )}
          <button class="surprise-button" data-surprise>
            <Icon name="shuffle" />
            {tx("Surprise me", "สุ่มภาพให้หน่อย")}
          </button>
        </div>
        <p class="gallery-status" aria-live="polite"></p>
        <div class="photo-grid">
          {shownPhotos.map((p, i) => (
            <button
              class="diary-photo photo-open"
              data-photo={p.id}
              data-category={p.category}
              data-character={p.character}
              aria-label={tx(
                `Open ${p.name} photo ${i + 1}`,
                `เปิดภาพ ${p.name} ${i + 1}`,
              )}
            >
              <img
                src={photoURL(p.id, true)}
                width={p.width}
                height={p.height}
                alt={`${p.alt}${p.credit ? `. Photo: ${p.credit}` : ""}`}
                loading="lazy"
                decoding="async"
              />
              <span>
                <strong>{p.name}</strong>
                <small>{p.series}</small>
                <b aria-hidden="true">+</b>
              </span>
            </button>
          ))}
        </div>
        <button class="pill load-more" hidden>
          {tx("A few more memories", "ดูความทรงจำเพิ่ม")} <span>＋</span>
        </button>
        <p class="source-note">
          {tx(
            "From @kayyalis.cos · Photographer credits and original posts accompany each photo.",
            "จาก @kayyalis.cos · เครดิตช่างภาพและโพสต์ต้นฉบับอยู่ในแต่ละภาพ",
          )}
        </p>
      </section>
      {shownClips.length > 0 && (
        <section id="motion" class="motion-section section-pad">
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">
                {character ? "02" : "03"} /{" "}
                {tx("A LITTLE MOVIE MAGIC", "เวทมนตร์ในคลิป")}
              </p>
              <h2>
                {tx("The little", "โรงหนัง")}
                <em>{tx("cosplay cinema.", "คอสเพลย์เล็ก ๆ")}</em>
              </h2>
            </div>
            <div>
              <p>
                {tx(
                  "Every cosplay clip, in one little cinema. Pick a character, swipe the filmstrip, or open the whole collection.",
                  "รวมทุกคลิปคอสเพลย์ในโรงหนังเล็ก ๆ เลือกตัวละคร เลื่อนฟิล์ม หรือเปิดดูคอลเลกชันทั้งหมด",
                )}
              </p>
              <button
                class="preview-toggle"
                data-preview-toggle
                aria-pressed="false"
              >
                {tx("Pause previews", "หยุดตัวอย่าง")}
              </button>
            </div>
          </div>
          <div class="cinema-toolbar">
            <div
              class="filter-pills cinema-platforms"
              role="group"
              aria-label={tx("Video source", "แหล่งวิดีโอ")}
            >
              <button data-film-platform="TikTok" aria-pressed="true">
                <Icon name="TikTok" />
                TikTok{" "}
                <small>
                  {shownClips.filter((c) => c.platform === "TikTok").length}
                </small>
              </button>
              <button data-film-platform="Instagram" aria-pressed="false">
                <Icon name="Instagram" />
                Reels{" "}
                <small>
                  {shownClips.filter((c) => c.platform === "Instagram").length}
                </small>
              </button>
              <button data-film-platform="all" aria-pressed="false">
                {tx("All", "ทั้งหมด")}
              </button>
            </div>
            {!character && (
              <label class="character-select">
                <span>{tx("Character", "ตัวละคร")}</span>
                <select id="film-character">
                  <option value="all">
                    {tx("All characters", "ทุกตัวละคร")}
                  </option>
                  {characters
                    .filter((c) => c.clips.length)
                    .map((c) => (
                      <option value={c.id}>{c.name}</option>
                    ))}
                </select>
              </label>
            )}
            <button class="film-view" data-film-view aria-pressed="false">
              ▦ {tx("Browse all", "ดูทั้งหมด")}
            </button>
          </div>
          <div class="cinema-status">
            <p data-film-status aria-live="polite"></p>
            <div class="film-arrows">
              <button
                data-film-prev
                aria-label={tx("Previous videos", "วิดีโอก่อนหน้า")}
              >
                ←
              </button>
              <button
                data-film-next
                aria-label={tx("Next videos", "วิดีโอถัดไป")}
              >
                →
              </button>
            </div>
          </div>{" "}
          <div
            class="reel-track"
            tabindex="0"
            aria-label={tx(
              "Swipeable cosplay video collection",
              "คอลเลกชันวิดีโอคอสเพลย์ เลื่อนเพื่อดูเพิ่ม",
            )}
          >
            {shownClips.map((v, i) => {
              const c = characters.find((c) => c.id === v.character)!;
              return (
                <button
                  class="reel-card"
                  data-clip={v.id}
                  data-film-platform-name={v.platform}
                  data-film-character={v.character}
                  style={`--look-color:${c.note.color}`}
                  aria-label={tx(
                    `Play ${c.name} ${v.platform} clip ${i + 1}`,
                    `เล่นคลิป ${c.name} ${v.platform} ${i + 1}`,
                  )}
                >
                  <img
                    src={clipPoster(v.id)}
                    width={v.width}
                    height={v.height}
                    alt={`${c.name} cosplay video preview`}
                    loading="lazy"
                  />
                  <video
                    class="ambient-video"
                    data-preview-src={clipURL(v.id, true)}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                    tabindex="-1"
                    disablepictureinpicture
                  ></video>
                  <span class="reel-platform">
                    <Icon name={v.platform} />
                    {v.platform}
                  </span>
                  <span class="reel-play" aria-hidden="true">
                    ▶
                  </span>
                  <span class="reel-caption">
                    <strong>{c.name}</strong>
                    <span class="reel-series">{c.series}</span>
                    <small>
                      {Math.round(v.duration)}s ·{" "}
                      {tx("Watch full clip", "ชมคลิปเต็ม")} ↗
                    </small>
                  </span>
                </button>
              );
            })}
          </div>
          <div class="reel-bottom">
            <span>
              ← {tx("Swipe, drag, or use the arrows", "ปัด ลาก หรือกดลูกศร")} →
            </span>
            <span>
              {shownClips.length} {tx("little transformations", "คลิปคอสเพลย์")}
            </span>
          </div>
        </section>
      )}
      {!character && (
        <section class="about-cos section-pad" id="about">
          <div class="about-photo reveal">
            <img
              src={photoURL(
                characters.find((c) => c.id === "yixuan")!.cover.id,
              )}
              width="800"
              height="1000"
              alt="Dada cosplaying Yixuan"
              loading="lazy"
            />
            <span class="tape" aria-hidden="true"></span>
            <span class="handwritten">a little about the girl ♡</span>
          </div>
          <div class="about-copy reveal">
            <p class="eyebrow">
              04 / {tx("BEHIND THE CHARACTER", "คนที่อยู่เบื้องหลัง")}
            </p>
            <h2>
              {tx("Still Dada.", "ยังเป็นด้า")}
              <em>{tx("Just a little different.", "ในอีกมุมหนึ่ง")}</em>
            </h2>
            <p>
              {tx(
                "Dada is the girl. Kayyalis is the cosplay diary. A collection of favourite characters, playful transformations, and little details worth keeping.",
                "Dada คือด้า ส่วน Kayyalis คือบันทึกคอสเพลย์ รวมตัวละครที่รัก การแปลงโฉมสนุก ๆ และรายละเอียดเล็ก ๆ ที่อยากเก็บไว้",
              )}
            </p>
            <p>
              {tx(
                "A little makeup, a costume, a new expression. This diary brings together game worlds, anime stories and the joy of trying something new.",
                "แต่งหน้าอีกนิด ใส่ชุดคอสเพลย์ แล้วลองเปลี่ยนสีหน้า บันทึกนี้รวมโลกของเกม อนิเมะ และความสนุกของการลองสิ่งใหม่",
              )}
            </p>
            <div class="about-tags">
              <span>🍓 just for fun</span>
              <span>TH / ENG OK!</span>
              <span>cosplay & character makeup</span>
            </div>
            <a class="text-link" href={home(lang)}>
              <Icon name="mic" />
              {tx("Meet my on-stage side", "รู้จักด้าบนเวที")} ↗
            </a>
          </div>
        </section>
      )}
      <section id="contact" class="cos-contact section-pad">
        <Doodles class="doodle-corner" kind="heart" />
        <Doodles class="doodle-low" kind="star" />
        <span class="contact-flower" aria-hidden="true">
          ✿
        </span>
        <p class="eyebrow">
          {tx("LET’S MEET IN THE SAME UNIVERSE", "มาเจอกันในจักรวาลเดียวกัน")}
        </p>
        <h2>
          {tx("A little hello", "แค่คำทักทาย")}
          <em>{tx("could be the start.", "ก็เป็นจุดเริ่มต้น")}</em>
        </h2>
        <p>
          {tx(
            "For cosplay conversations, creative ideas, and the next character to fall in love with.",
            "คุยเรื่องคอสเพลย์ ไอเดียสร้างสรรค์ และตัวละครตัวต่อไปที่จะตกหลุมรัก",
          )}
        </p>
        <div class="contact-cards">
          <a href={instagram} target="_blank" rel="noopener noreferrer">
            <span class="contact-icon">
              <Icon name="Instagram" />
            </span>
            <span>
              <small>{tx("THE COSPLAY DIARY", "บันทึกคอสเพลย์")}</small>
              <strong>@kayyalis.cos</strong>
              <em>Instagram</em>
            </span>
            <b>↗</b>
          </a>
          <a href={tiktok} target="_blank" rel="noopener noreferrer">
            <span class="contact-icon">
              <Icon name="TikTok" />
            </span>
            <span>
              <small>{tx("THE MOVING MOMENTS", "ช่วงเวลาที่เคลื่อนไหว")}</small>
              <strong>@keewadun</strong>
              <em>TikTok</em>
            </span>
            <b>↗</b>
          </a>
        </div>
        <a class="contact-mc" href={home(lang)}>
          <Icon name="mic" />
          {tx(
            "Looking for the MC portfolio? Meet Dada on stage",
            "กำลังหาผลงานพิธีกร? พบกับ Dada บนเวที",
          )}{" "}
          ↗
        </a>
      </section>
    </main>
    <footer class="cos-footer">
      <a class="cos-brand" href={cosplayHome(lang)}>
        kayyalis<span>✿</span>
      </a>
      <p>
        Kunwadee Phanompotivong · Dada
        <br />
        <small>
          {tx(
            "A little cosplay universe. Made with heart.",
            "โลกคอสเพลย์เล็ก ๆ ที่สร้างด้วยหัวใจ",
          )}
        </small>
      </p>
      <a
        class="back-top"
        href="#main"
        aria-label={tx("Back to top", "กลับด้านบน")}
      >
        ↑
      </a>
    </footer>
    <dialog id="cos-menu" class="cos-menu" aria-labelledby="menu-title">
      <div class="menu-top">
        <span id="menu-title">{tx("Where shall we go?", "ไปไหนดี?")} ✧</span>
        <button
          class="round-button"
          data-close
          aria-label={tx("Close menu", "ปิดเมนู")}
        >
          ×
        </button>
      </div>
      <nav aria-label={tx("Expanded navigation", "เมนูทั้งหมด")}>
        {[
          ["characters", "The wardrobe", "ตัวละคร"],
          ["gallery", "Photo diary", "ภาพถ่าย"],
          ["motion", "In motion", "วิดีโอ"],
          ["about", "Behind the character", "รู้จักกัน"],
          ["contact", "Say a little hello", "ทักทายกัน"],
        ].map(([id, en, th], i) => (
          <a href={`${cosplayHome(lang)}#${id}`} style={`--delay:${i * 45}ms`}>
            <small>0{i + 1}</small>
            {tx(en, th)}
            <span>↗</span>
          </a>
        ))}
      </nav>
      <a class="pill" href={home(lang)}>
        <Icon name="mic" />
        {tx("Dada’s MC portfolio", "ผลงานพิธีกร Dada")} ↗
      </a>
      <span class="menu-doodle" aria-hidden="true">
        🍓 ♡ ✧
      </span>
    </dialog>
    <dialog class="media-dialog" id="cos-media" aria-labelledby="media-title">
      <div class="media-top">
        <span id="media-counter"></span>
        <button
          data-media-close
          class="round-button"
          aria-label={tx("Close viewer", "ปิดภาพและวิดีโอ")}
        >
          ×
        </button>
      </div>
      <div class="media-stage"></div>
      <div class="media-info">
        <div>
          <h2 id="media-title"></h2>
          <p id="media-detail"></p>
          <small id="media-credit"></small>
        </div>
        <div class="media-actions">
          <button
            class="round-button"
            data-prev
            aria-label={tx("Previous item", "ก่อนหน้า")}
          >
            ←
          </button>
          <button
            class="round-button"
            data-next
            aria-label={tx("Next item", "ถัดไป")}
          >
            →
          </button>
          <a id="media-source" target="_blank" rel="noopener noreferrer">
            {tx("Original post", "โพสต์ต้นฉบับ")} ↗
          </a>
        </div>
      </div>
      <p class="media-hint">
        {tx(
          "Use ← → to explore · Esc to close",
          "ใช้ ← → เพื่อดูต่อ · Esc เพื่อปิด",
        )}
      </p>
    </dialog>
    <script
      id="cos-media-data"
      type="application/json"
      set:html={JSON.stringify({
        photos,
        clips,
        characters: characters.map((c) => ({
          id: c.id,
          name: c.name,
          series: c.series,
        })),
        base,
      }).replace(/</g, "\\u003c")}
    />
    <script>
      import "../scripts/cosplay";
    </script>
  </body>
</html>
